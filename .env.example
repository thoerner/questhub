# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/questhub

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials
# Register at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to true when running behind a reverse proxy or in a container (e.g. App Runner, Docker)
# AUTH_TRUST_HOST=true

# Optional: GitHub personal access token for higher API rate limits (5,000/hr vs 60/hr)
# Create one at https://github.com/settings/tokens with no scopes (public repo read is default)
GITHUB_TOKEN=
